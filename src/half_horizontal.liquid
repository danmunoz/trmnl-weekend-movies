<div class="layout layout--col layout--stretch-x wm-shell wm-shell--half-horizontal wm-film-frame">
  <span class="wm-film-perf wm-film-perf--top" aria-hidden="true"></span>
  {% if setup_needed %}
    <section class="wm-empty wm-empty--compact wm-card">
      <p class="wm-kicker">Weekend Movie Picker</p>
      <h1 class="wm-empty__title">Add setup info.</h1>
      <p class="wm-empty__body">Choose a region to load the weekend slate.</p>
    </section>
  {% elsif no_results %}
    <section class="wm-empty wm-empty--compact wm-card">
      <p class="wm-kicker">{{ region_name }} • {{ weekend_label }}</p>
      <h1 class="wm-empty__title">No qualifying releases.</h1>
      <p class="wm-empty__body">{{ status_message }}</p>
    </section>
  {% else %}
    <section class="wm-card wm-half-strip-card">
      <div class="wm-half-strip-grid">
        <article class="wm-half-strip-movie">
          <div class="wm-poster-frame wm-poster-frame--half-strip">
            {% if hero_poster_url != blank %}
              <img class="wm-poster image image-dither image--cover" src="{{ hero_poster_url }}" alt="{{ hero.title }} poster">
            {% else %}
              <div class="wm-poster--placeholder">{{ hero.title }}</div>
            {% endif %}
          </div>

          <div class="wm-half-strip-copy">
            <p class="wm-half-strip-title wm-line-clamp-2">{{ hero.title }}</p>
            <p class="wm-half-strip-meta wm-line-clamp-2">
              {{ hero_runtime_display }}
              {% if hero_genres_display != blank %}
                • {{ hero_genres_display | strip }}
              {% endif %}
            </p>
            <p class="wm-half-strip-summary" data-wm-fit-summary="true">{{ hero.overview | strip_html }}</p>
          </div>
        </article>

        {% if support_one != blank %}
          <article class="wm-half-strip-movie">
            <div class="wm-poster-frame wm-poster-frame--half-strip">
              {% if support_one_poster_url != blank %}
                <img class="wm-poster image image-dither image--cover" src="{{ support_one_poster_url }}" alt="{{ support_one.title }} poster">
              {% else %}
                <div class="wm-poster--placeholder">{{ support_one.title }}</div>
              {% endif %}
            </div>

            <div class="wm-half-strip-copy">
              <p class="wm-half-strip-title wm-line-clamp-2">{{ support_one.title }}</p>
              <p class="wm-half-strip-meta wm-line-clamp-2">
                {{ support_one_runtime_display }}
                {% if support_one_genres_display != blank %}
                  • {{ support_one_genres_display | strip }}
                {% endif %}
              </p>
              <p class="wm-half-strip-summary" data-wm-fit-summary="true">{{ support_one.overview | strip_html }}</p>
            </div>
          </article>
        {% endif %}

        {% if support_two != blank %}
          <article class="wm-half-strip-movie">
            <div class="wm-poster-frame wm-poster-frame--half-strip">
              {% if support_two_poster_url != blank %}
                <img class="wm-poster image image-dither image--cover" src="{{ support_two_poster_url }}" alt="{{ support_two.title }} poster">
              {% else %}
                <div class="wm-poster--placeholder">{{ support_two.title }}</div>
              {% endif %}
            </div>

            <div class="wm-half-strip-copy">
              <p class="wm-half-strip-title wm-line-clamp-2">{{ support_two.title }}</p>
              <p class="wm-half-strip-meta wm-line-clamp-2">
                {{ support_two_runtime_display }}
                {% if support_two_genres_display != blank %}
                  • {{ support_two_genres_display | strip }}
                {% endif %}
              </p>
              <p class="wm-half-strip-summary" data-wm-fit-summary="true">{{ support_two.overview | strip_html }}</p>
            </div>
          </article>
        {% endif %}
      </div>
    </section>
  {% endif %}
  <span class="wm-film-perf wm-film-perf--bottom" aria-hidden="true"></span>
</div>
<div class="title_bar">
  <img class="image" src="https://trmnl.com/images/plugins/trmnl--render.svg" alt="">
  <span class="title">Weekend Movie Picker</span>
  <span class="instance">
    {% if setup_needed %}
      Setup
    {% else %}
      {{ region_short_name }}
    {% endif %}
  </span>
</div>
