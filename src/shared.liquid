<script>
  document.addEventListener("DOMContentLoaded", function() {
    document.documentElement.classList.add("wm-js-ready");

    function fitSummaryText(node) {
      const fullText = (node.dataset.wmFullText || node.textContent || "").trim();
      if (!fullText) return;

      node.dataset.wmFullText = fullText;
      node.textContent = fullText;

      const availableHeight = node.clientHeight;
      if (!availableHeight) return;

      if (node.scrollHeight <= availableHeight + 1) return;

      const words = fullText.split(/\s+/).filter(Boolean);
      let low = 0;
      let high = words.length;
      let best = "";

      while (low <= high) {
        const mid = Math.floor((low + high) / 2);
        const candidate = mid >= words.length ? fullText : words.slice(0, mid).join(" ") + "…";
        node.textContent = candidate;

        if (node.scrollHeight <= availableHeight + 1) {
          best = candidate;
          low = mid + 1;
        } else {
          high = mid - 1;
        }
      }

      if (best) {
        node.textContent = best;
        return;
      }

      let charLow = 0;
      let charHigh = fullText.length;
      let charBest = "";

      while (charLow <= charHigh) {
        const mid = Math.floor((charLow + charHigh) / 2);
        const candidate = mid >= fullText.length ? fullText : fullText.slice(0, mid).trimEnd() + "…";
        node.textContent = candidate;

        if (node.scrollHeight <= availableHeight + 1) {
          charBest = candidate;
          charLow = mid + 1;
        } else {
          charHigh = mid - 1;
        }
      }

      node.textContent = charBest || "…";
    }

    function fitAllSummaries() {
      document.querySelectorAll('[data-wm-fit-summary="true"]').forEach(fitSummaryText);
    }

    function fitQuadrantPick(node) {
      const poster = node.querySelector('.wm-poster-frame--quadrant-tile');
      const copy = node.querySelector('.wm-quadrant-copy');
      const title = node.querySelector('.wm-quadrant-title');
      const summary = node.querySelector('.wm-quadrant-summary');
      const optionals = Array.from(node.querySelectorAll('[data-wm-quadrant-optional]')).sort(function(a, b) {
        const priorityA = Number.parseInt(a.dataset.wmQuadrantPriority || "99", 10);
        const priorityB = Number.parseInt(b.dataset.wmQuadrantPriority || "99", 10);
        return priorityA - priorityB;
      });
      if (!poster || !copy || !title) return;

      const gapValue = parseFloat(getComputedStyle(node).gap || getComputedStyle(node).rowGap || "0");
      node.style.setProperty('--wm-quadrant-pick-gap', gapValue + 'px');
      copy.style.width = Math.ceil(poster.getBoundingClientRect().width) + 'px';
      copy.style.height = '';

      optionals.forEach(function(item) {
        item.classList.remove('wm-quadrant-visible');
      });

      node.style.setProperty('--wm-quadrant-copy-min-height', Math.ceil(title.getBoundingClientRect().height) + 'px');

      if (optionals.length === 0) return;

      const remainingHeight = node.clientHeight - poster.getBoundingClientRect().height - gapValue;
      const nonSummaryOptionals = optionals.filter(function(item) {
        return item !== summary;
      });

      nonSummaryOptionals.forEach(function(item) {
        item.classList.add('wm-quadrant-visible');

        if (copy.scrollHeight > remainingHeight + 1) {
          item.classList.remove('wm-quadrant-visible');
        }
      });

      if (summary) {
        const minimumSummaryHeight = 12;
        const fixedCopyHeight = copy.scrollHeight;
        const availableSummaryHeight = Math.floor(remainingHeight - fixedCopyHeight);

        if (availableSummaryHeight >= minimumSummaryHeight) {
          summary.classList.add('wm-quadrant-visible');
          summary.style.height = availableSummaryHeight + 'px';
          copy.style.height = Math.max(remainingHeight, 0) + 'px';
          fitSummaryText(summary);
        } else {
          summary.classList.remove('wm-quadrant-visible');
          summary.style.height = '';
          copy.style.height = '';
        }
      }
    }

    function fitQuadrantDetails() {
      document.querySelectorAll('.wm-quadrant-pick').forEach(fitQuadrantPick);
    }

    requestAnimationFrame(function() {
      requestAnimationFrame(fitAllSummaries);
      requestAnimationFrame(fitQuadrantDetails);
    });

    window.addEventListener('load', fitQuadrantDetails);
  });
</script>
